###############################################################################
# RAG-RBAC environment configuration
# Copy this file to .env and adjust values for your environment.
###############################################################################

# ---- App ---------------------------------------------------------------------
APP_ENV=development              # development | production
DEBUG=true
# IMPORTANT: generate a long, random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed by the API.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ---- Postgres ----------------------------------------------------------------
# For local Docker Postgres:
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=ragdb
POSTGRES_PORT=5432
# For Neon (cloud), use your Neon credentials instead:
# POSTGRES_HOST=your-project.eu-west-2.aws.neon.tech
# POSTGRES_USER=neondb_owner
# POSTGRES_PASSWORD=your-neon-password
# POSTGRES_DB=neondb
# POSTGRES_SSL=require

# ---- Ollama ------------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text   # 768-dim embeddings
OLLAMA_LLM_MODEL=llama3.1                 # generator model
EMBEDDING_DIMENSION=768                    # must match the chosen embedding model
OLLAMA_TIMEOUT=120

# ---- RAG ---------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
RELEVANCE_THRESHOLD=0.3
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_TEXT_WEIGHT=0.3

# ---- File upload -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_AUTH=10/minute

# ---- Docker / ports ----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
WORKERS=1

# Set to true to seed demo users + sample documents on first boot.
RUN_SEED=true
